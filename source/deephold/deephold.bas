# DEEPHOLD: a small text adventure in UNC BASIC, for a UNC 16.
# Lines starting with # are notes: they aren't typed in.
#
# UNC BASIC has no strings, so the parser is made of numbers. The line you type is kept
# as key codes at 64 upwards (the fast page), and each word is boiled down to one number
# from its first three letters: (1st*27+2nd)*27+3rd, with A=1 to Z=26. LAMP, LAMPS and
# LAMBADA are all 8788. The first word is the verb V, the second the noun N; THE, WITH,
# IN and the like are thrown away. Where each thing lies is a byte at 1 to 7: a room's
# number, 99 for carried, 98 for in the chest, 0 for not in the game yet.
#
# R room  B lamp lit  T lamp's life  A troll alive  U rug moved  G trapdoor open
# X casket open  Y letterbox open  H wounds  D turns spent in the dark  Z moves  S score
10 REM *** DEEPHOLD ***
20 REM UNITED NORTHERN COMPUTERS
30 CLS:POKE 1,0:POKE 2,3:POKE 3,3:POKE 4,10:POKE 5,11:POKE 6,0:POKE 7,0
40 R=1:T=150:A=1
50 PRINT "DEEPHOLD":PRINT "AN ADVENTURE UNDERGROUND"
60 PRINT "UNITED NORTHERN COMPUTERS":PRINT
70 PRINT "(TYPE HELP IF YOU ARE LOST.)":PRINT
80 GOSUB 1000
100 PRINT:PRINT ">";:L=0
110 P=1024+PEEK(513)*40+PEEK(512):POKE P,160
120 K=GET:IF K=0 THEN I=RND(2):GOTO 120
125 IF K=13 THEN POKE P,32:PRINT:GOTO 150
130 IF K=8 AND L>0 THEN L=L-1:POKE P,32:POKE 512,PEEK(512)-1:GOTO 110
135 IF K<32 OR K>95 OR L>30 THEN 120
140 POKE P,K:POKE 64+L,K:L=L+1:POKE 512,PEEK(512)+1:GOTO 110
150 V=0:N=0:W=0:C=0:POKE 64+L,32
160 FOR I=0 TO L:K=PEEK(64+I)
165 IF K>64 AND K<91 AND C<3 THEN W=W*27+K-64:C=C+1
170 IF K<>32 OR W=0 THEN 195
175 IF W=14801 OR W=1 OR W=41 OR W=17030 OR W=555 OR W=47 OR W=257 THEN 190
180 IF (W=419 AND V<>15165) OR (W=11103 AND V<>15165) OR W=6959 OR W=15691 OR (W=583 AND V=11910) THEN 190
182 IF V=15165 AND W=419 THEN V=8998:GOTO 190
183 IF V=15165 AND W=11103 THEN V=4313:GOTO 190
185 IF V=0 THEN V=W:GOTO 190
187 IF N=0 THEN N=W
190 W=0:C=0
195 NEXT I
200 IF V=0 THEN PRINT "BEG PARDON?":GOTO 100
205 IF V=204 OR V=16806 OR V=13703 THEN V=N:N=0
210 IF V=2520 THEN V=21:IF N=3344 OR N=4 THEN V=4
215 M=-(V=14 OR V=10629)-2*(V=19 OR V=14277)-3*(V=5 OR V=3691)
220 M=M-4*(V=23 OR V=16921)-5*(V=21 OR V=583)-6*(V=4 OR V=3344)
225 IF M THEN 400
230 O=-(N=8884)-2*(N=8788 OR N=8789 OR N=8998)-3*(N=14487)-4*(N=3841)-5*(N=8179)
235 O=O-6*(N=13691)-7*(N=2688)-8*(N=8903 OR N=1887 OR N=9513)-9*(N=13696)
240 O=O-10*(N=15067 OR N=3336)-11*(N=15081)-12*(N=2233)-13*(N=2408)
245 O=O-14*(N=15071 OR N=11921)-15*(N=14153 OR N=1877)
250 IF (V=12 OR V=9168) AND N=0 THEN GOSUB 1000:GOTO 300
252 IF V=12 OR V=9168 OR V=24 THEN V=4294
254 IF V=9 OR V=6961 THEN 500
256 IF V=13947 THEN GOSUB 950:GOTO 100
258 IF V=17 OR V=12969 THEN GOSUB 950:PRINT "FAREWELL.":END
260 IF V=5979 THEN 900
262 IF V=18197 OR V=12009 THEN PRINT "NOTHING HAPPENS.":GOTO 300
264 IF V=16803 OR V=26 THEN PRINT "TIME PASSES.":GOTO 300
266 IF V=7870 THEN 740
268 IF V=8998 THEN 720
270 IF V=4313 OR V=3342 THEN 730
272 IF V=15165 THEN GOTO 720+10*B
274 Q=-(V=14618 OR V=5258 OR V=11910)-2*(V=3417 OR V=12251)-3*(V=11372 OR V=15699)
276 Q=Q-4*(V=9904 OR V=12243 OR V=12250 OR V=8997)-5*(V=8274 OR V=1289 OR V=4624 OR V=6095)
278 Q=Q-6*(V=13258)-7*(V=4294)
280 IF Q=0 THEN PRINT "I DON'T KNOW THAT VERB.":GOTO 100
282 IF N=0 THEN PRINT "YOU'LL HAVE TO SAY WHAT.":GOTO 100
284 IF O=0 THEN PRINT "I DON'T KNOW THAT WORD.":GOTO 100
286 IF Q=2 THEN 540
288 GOSUB 800:IF E=0 THEN PRINT "IT'S TOO DARK TO SEE.":GOTO 300
290 IF P=0 THEN PRINT "YOU DON'T SEE THAT HERE.":GOTO 300
292 GOTO 500+Q*20
300 Z=Z+1:IF B THEN T=T-1:IF T=20 THEN PRINT "YOUR LAMP IS GROWING DIM."
310 IF B AND T<1 THEN B=0:PRINT "YOUR LAMP FLICKERS AND DIES.":GOSUB 1000
320 GOSUB 850:IF E THEN D=0:GOTO 100
330 D=D+1:IF D<2 THEN 100
340 PRINT "SOMETHING HUGE CLOSES ITS JAWS ON YOU":PRINT "IN THE DARK."
350 GOTO 970
400 Q=0:GOSUB 2000+R*20:IF Q=0 THEN PRINT "YOU CAN'T GO THAT WAY."
410 IF Q>0 THEN R=Q:GOSUB 1000
420 GOTO 300
500 PRINT "YOU ARE CARRYING:":J=0:FOR O=1 TO 7
505 IF PEEK(O)=99 THEN PRINT "  ";:GOSUB 3000+O*10:PRINT:J=1
510 NEXT O:IF J=0 THEN PRINT "  NOTHING."
515 GOTO 300
520 IF O>7 THEN PRINT "YOU CAN'T TAKE THAT.":GOTO 300
525 IF PEEK(O)=99 THEN PRINT "YOU ALREADY HAVE IT.":GOTO 300
530 POKE O,99:PRINT "TAKEN.":GOTO 300
540 IF O>7 THEN PRINT "YOU AREN'T CARRYING THAT.":GOTO 300
542 IF PEEK(O)<>99 THEN PRINT "YOU AREN'T CARRYING THAT.":GOTO 300
544 IF R=10 THEN POKE O,2:PRINT "IT FALLS TO THE GROUND BELOW.":GOTO 300
546 IF R<>3 OR O<4 OR O=5 THEN POKE O,R:PRINT "DROPPED.":GOTO 300
548 POKE O,98:PRINT "YOU LAY IT IN THE OAK CHEST.":GOSUB 950
550 IF S=100 THEN 980
552 GOTO 300
560 IF O=8 AND Y THEN PRINT "IT IS OPEN ALREADY.":GOTO 300
562 IF O=8 THEN Y=1:POKE 1,1:PRINT "INSIDE THE LETTERBOX IS A LEAFLET.":GOTO 300
564 IF O=10 AND G THEN PRINT "IT IS OPEN ALREADY.":GOTO 300
566 IF O=10 THEN G=1:PRINT "THE TRAPDOOR CREAKS OPEN ON DARKNESS.":GOTO 300
568 IF O=13 OR (O=12 AND X) THEN PRINT "IT IS OPEN ALREADY.":GOTO 300
570 IF O<>12 THEN PRINT "YOU CAN'T OPEN THAT.":GOTO 300
572 IF PEEK(5)<>99 THEN PRINT "IT IS LOCKED, AND YOU HAVE NO KEY.":GOTO 300
574 X=1:POKE 7,6:PRINT "THE KEY TURNS. INSIDE, ON ROTTED":PRINT "VELVET, LIES A GOLDEN CROWN!":GOTO 300
580 IF O=9 AND U THEN PRINT "YOU HAVE MOVED IT ALREADY.":GOTO 300
582 IF O<>9 THEN PRINT "IT WON'T BUDGE.":GOTO 300
584 U=1:PRINT "YOU DRAG THE RUG ASIDE. THERE IS A":PRINT "TRAPDOOR IN THE FLOOR BENEATH IT!":GOTO 300
600 IF O<>11 THEN PRINT "FIGHTING THAT WOULD GET YOU NOWHERE.":GOTO 300
602 IF PEEK(3)<>99 THEN PRINT "WITH YOUR BARE HANDS? THE TROLL LAUGHS.":GOTO 300
604 J=RND(4):IF J=1 THEN PRINT "CLANG! SWORD MEETS CLUB.":GOTO 300
606 IF J>1 THEN 612
608 H=H+1:IF H=1 THEN PRINT "THE CLUB CATCHES YOUR SHOULDER. YOU":PRINT "ARE HURT, AND CAN'T TAKE ANOTHER.":GOTO 300
610 PRINT "THE CLUB COMES DOWN. IT IS THE LAST":PRINT "THING YOU SEE.":GOTO 970
612 A=0:POKE 6,5:PRINT "YOUR BLADE GOES HOME. THE TROLL HOWLS":PRINT "AND TOPPLES INTO THE CHASM. SOMETHING"
614 PRINT "RED DROPS FROM ITS NECK AS IT GOES.":GOTO 300
620 IF O<>1 THEN PRINT "THERE IS NOTHING TO READ ON IT.":GOTO 300
622 PRINT " WELCOME TO DEEPHOLD!":PRINT " THREE TREASURES LIE UNDER THIS CABIN."
624 PRINT " LAY THEM IN THE OAK CHEST AND BE":PRINT " CALLED A MASTER. CARRY A LIGHT:"
626 PRINT " THE DARK DOWN THERE BITES.":GOTO 300
640 IF O=2 THEN PRINT "A BRASS LAMP. IT WILL BURN FOR ABOUT":PRINT T;" MORE MOVES.":GOTO 300
642 IF O=3 THEN PRINT "OLD, PLAIN AND VERY SHARP.":GOTO 300
644 IF O=8 AND Y=0 THEN PRINT "A SMALL LETTERBOX. IT IS CLOSED.":GOTO 300
646 IF O=9 THEN PRINT "IT DOESN'T LIE QUITE FLAT.":GOTO 300
648 IF O=11 THEN PRINT "BIG, GREEN AND IN YOUR WAY. A RED":PRINT "STONE HANGS AT ITS NECK.":GOTO 300
650 IF O=12 THEN PRINT "HEAVY IRON, WITH A SMALL KEYHOLE.":GOTO 300
652 IF O=13 THEN GOSUB 950:GOTO 300
654 IF O=14 THEN PRINT "ITS BRANCHES WOULD MAKE A GOOD LADDER.":GOTO 300
656 IF O=15 THEN PRINT "WHOEVER IT WAS CAME LOOKING FOR THE":PRINT "CROWN, AND TOOK A WRONG TURNING.":GOTO 300
658 IF O=1 THEN 622
660 PRINT "YOU SEE NOTHING SPECIAL ABOUT IT.":GOTO 300
720 IF PEEK(2)<>99 AND PEEK(2)<>R THEN PRINT "YOU HAVE NO LAMP.":GOTO 300
721 IF B THEN PRINT "IT IS ALREADY ON.":GOTO 300
722 IF T<1 THEN PRINT "THE LAMP IS SPENT.":GOTO 300
724 B=1:PRINT "THE LAMP IS NOW ON.":GOSUB 850:IF D THEN GOSUB 1000
726 GOTO 300
730 IF B=0 THEN PRINT "IT ISN'T LIT.":GOTO 300
732 B=0:PRINT "THE LAMP IS NOW OFF.":GOSUB 850:IF E=0 THEN GOSUB 1000
734 GOTO 300
740 IF R=10 THEN PRINT "YOU CRASH DOWN THROUGH THE BRANCHES.":R=2:GOSUB 1000:GOTO 300
742 IF R<>5 THEN PRINT "WHEEE!":GOTO 300
744 PRINT "YOU LEAP. THE CHASM IS MUCH WIDER THAN":PRINT "IT LOOKED, AND MUCH DEEPER.":GOTO 970
800 P=0:GOSUB 850:IF E=0 THEN RETURN
810 IF O<8 THEN P=(PEEK(O)=R OR PEEK(O)=99):RETURN
820 P=(O=8 AND R=1) OR (O=9 AND R=3) OR (O=10 AND R=3 AND U=1) OR (O=11 AND R=5 AND A=1)
830 P=P OR (O=12 AND R=6) OR (O=13 AND R=3) OR (O=14 AND (R=2 OR R=10)) OR (O=15 AND R=11)
840 RETURN
850 E=1:IF R<4 OR R=10 THEN RETURN
860 E=0:IF B=1 AND (PEEK(2)=99 OR PEEK(2)=R) THEN E=1
870 RETURN
900 PRINT "TELL ME WHAT TO DO IN A WORD OR TWO:":PRINT "  NORTH (OR N), UP, TAKE LAMP, OPEN IT,"
910 PRINT "  LOOK, INVENTORY (I), EXAMINE (X) RUG,":PRINT "  LIGHT LAMP, DROP KEY, READ, KILL,"
920 PRINT "  SCORE, QUIT. I KNOW A WORD BY ITS":PRINT "  FIRST THREE LETTERS.":GOTO 100
950 S=0:FOR I=4 TO 7:IF PEEK(I)=98 THEN S=S+30
955 NEXT I:IF A=0 THEN S=S+10
960 PRINT "YOU HAVE ";S;" POINTS OF 100, IN ";Z:PRINT "MOVES. THE CHEST HOLDS ";S/30;" OF 3."
965 RETURN
970 PRINT:PRINT "   **** YOU HAVE DIED ****":PRINT:GOSUB 950:PRINT "RANK: ";
972 IF S<40 THEN PRINT "TROLL FODDER"
974 IF S>30 THEN PRINT "JOURNEYMAN DELVER"
976 PRINT:PRINT "ANOTHER GO (Y/N)?"
977 K=GET:IF K=89 THEN RUN
978 IF K<>78 THEN 977
979 PRINT "FAREWELL.":END
980 PRINT:PRINT "THE LAST TREASURE SETTLES INTO THE":PRINT "CHEST. THE LID SWINGS SHUT BY ITSELF,"
982 PRINT "AND SOMEWHERE BELOW A GREAT DOOR":PRINT "CLOSES FOR GOOD. DEEPHOLD IS EMPTY."
984 PRINT:PRINT "RANK: MASTER DELVER, IN ";Z+1;" MOVES.":PRINT:PRINT "   **** YOU HAVE WON ****":END
1000 GOSUB 850:IF E=0 THEN PRINT "IT IS PITCH DARK. SOMETHING IS":PRINT "BREATHING, VERY CLOSE TO YOU.":RETURN
1010 GOSUB 1100+R*20:FOR O=1 TO 7
1020 IF PEEK(O)=R THEN PRINT "THERE IS ";:GOSUB 3000+O*10:PRINT " HERE."
1030 NEXT O:RETURN
1120 PRINT "FOREST CLEARING":PRINT "YOU STAND BEFORE A SMALL LOG CABIN. ITS"
1122 PRINT "DOOR, TO THE EAST, HANGS OPEN. A PATH":PRINT "RUNS NORTH INTO THE TREES. A LETTERBOX"
1124 PRINT "LEANS ON ITS POST.":RETURN
1140 PRINT "FOREST PATH":PRINT "TALL PINES CROWD THE PATH, WHICH ENDS"
1142 PRINT "HERE. ONE OLD PINE HAS LOW BRANCHES.":PRINT "THE CLEARING IS BACK SOUTH.":RETURN
1160 PRINT "CABIN":PRINT "ONE DUSTY ROOM. AN OAK CHEST STANDS"
1162 PRINT "OPEN BY THE HEARTH. THE DOOR IS WEST."
1164 IF U=0 THEN PRINT "A WORN RUG COVERS THE FLOOR."
1166 IF U=1 AND G=0 THEN PRINT "BY THE RUG IS A CLOSED TRAPDOOR."
1168 IF G THEN PRINT "A TRAPDOOR GAPES OPEN IN THE FLOOR."
1170 RETURN
1180 PRINT "CELLAR":PRINT "A DAMP CELLAR OF ROUGH STONE. STEPS GO"
1182 PRINT "UP TO THE CABIN. LOW TUNNELS RUN NORTH":PRINT "AND EAST. THE NORTH ONE REEKS OF TROLL.":RETURN
1200 PRINT "CHASM":PRINT "A BLACK CHASM SPLITS THE CAVE. A NARROW"
1202 PRINT "STONE BRIDGE CROSSES IT TO THE NORTH.":PRINT "THE CELLAR IS SOUTH."
1204 IF A THEN PRINT "A WARTY TROLL BARS THE BRIDGE, CLUB IN":PRINT "HAND."
1206 RETURN
1220 PRINT "VAULT":PRINT "A ROUND VAULT, CUT BY HANDS LONG DEAD."
1222 PRINT "THE ONLY WAY OUT IS SOUTH.":IF X THEN PRINT "AN IRON CASKET STANDS OPEN."
1224 IF X=0 THEN PRINT "AN IRON CASKET SITS ON A PLINTH, SHUT."
1226 RETURN
1240 PRINT "MAZE":PRINT "A MAZE OF CROOKED LITTLE TUNNELS, ALL"
1242 PRINT "THE SAME. THEY LEAD OFF EVERY WAY.":RETURN
1260 GOTO 1240
1300 PRINT "UP A TREE":PRINT "YOU CLING TO THE TOP OF THE PINE. FAR"
1302 PRINT "OFF, MOUNTAINS. BESIDE YOU, A NEST.":RETURN
1320 PRINT "DEAD END":PRINT "THE TUNNEL ENDS AT A ROCKFALL. AGAINST"
1322 PRINT "IT SITS A SKELETON IN RUSTED MAIL,":PRINT "GRINNING. THE WAY BACK IS WEST.":RETURN
2020 Q=-2*(M=1)-3*(M=3):RETURN
2040 Q=-(M=2)-10*(M=5):RETURN
2060 Q=-(M=4):IF M=6 AND G THEN Q=4
2062 IF M=6 AND G=0 AND U THEN Q=-1:PRINT "THE TRAPDOOR IS SHUT."
2064 RETURN
2080 Q=-3*(M=5)-5*(M=1)-7*(M=3):RETURN
2100 Q=-4*(M=2)-6*(M=1):IF M=1 AND A THEN Q=-1:PRINT "THE TROLL SHOVES YOU BACK."
2102 RETURN
2120 Q=-5*(M=2):RETURN
2140 Q=7-(M=2)+3*(M=4):IF M>4 THEN Q=0
2142 RETURN
2160 Q=8+(M=1)-3*(M=3):IF M>4 THEN Q=0
2162 RETURN
2200 Q=-2*(M=6):RETURN
2220 Q=-8*(M=4):RETURN
3010 PRINT "A LEAFLET";:RETURN
3020 PRINT "A BRASS LAMP";:IF B THEN PRINT " (LIT)";
3025 RETURN
3030 PRINT "A SWORD";:RETURN
3040 PRINT "A JEWELLED EGG";:RETURN
3050 PRINT "A SMALL KEY";:RETURN
3060 PRINT "A RUBY";:RETURN
3070 PRINT "A GOLDEN CROWN";:RETURN
